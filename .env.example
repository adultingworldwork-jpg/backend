# ========================
# 🚀 App Configuration
# ========================

PORT=3000
NODE_ENV=development

API_PREFIX=/api
API_VERSION=v1

# Comma-separated Next.js origins (no trailing slash)
# Include local dev + every deployed frontend origin
CORS_ORIGIN=http://localhost:3001,https://audulting101.vercel.app

# ========================
# 🧠 Database
# ========================

DB_PROVIDER=mongodb
MONGO_URI=mongodb://localhost:27017/adulting101

# ========================
# 🔐 Authentication
# ========================

JWT_SECRET=SUPERSECURESECRET

# ========================
# 🔌 Plugins (comma separated)
# Examples: cloudinary,redis,cache,queue,events
# ========================

PLUGINS=cloudinary

# ========================
# ☁️ Cloudinary (uploads)
# Business modules never import the Cloudinary SDK.
# ========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=adulting101

# ========================
# 🔴 Redis (optional)
# ========================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# 📦 Queue / Jobs (optional)
# ========================

QUEUE_PREFIX=techunico

# ========================
# 📡 Metrics (optional)
# ========================

METRICS_ENABLED=true

LOG_LEVEL=info
